{
  "name": "finops-system",
  "version": "1.0.0",
  "description": "Sistema de Cadastro de Ações FinOps",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev --prefix frontend\"",
    "frontend:install": "npm install --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "frontend:test": "npm test --prefix frontend"
  },
  "dependencies": {
    "@dsnp/parquetjs": "^1.8.7",
    "adm-zip": "^0.5.17",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^4.1.0",
    "ldapjs": "^3.0.7",
    "multer": "^2.1.1",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.0.2",
    "playwright": "^1.62.1"
  }
}
