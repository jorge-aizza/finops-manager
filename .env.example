# FinOps Manager - Environment Variables Reference
#
# IMPORTANT: This file (.env.example) is a REFERENCE TEMPLATE ONLY
# Actual values MUST be set in .env (which is gitignored, never committed)
#
# SECRETS NEVER GO IN THE DATABASE
# All Service Principal credentials, API keys, and passwords are loaded from .env at boot
# and held in memory only — never persisted to the database.
#

# ========================================
# DATABASE CONNECTION
# ========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finops_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Alternative: use DATABASE_URL instead of individual DB_* vars (Railway, Render, Fly.io)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/finops_db?sslmode=require

# ========================================
# SERVER
# ========================================
PORT=3000
NODE_ENV=development
TZ=America/Sao_Paulo
ALLOWED_ORIGIN=http://localhost:3000

# ========================================
# AUTHENTICATION & SECURITY
# ========================================
# JWT token secret (min 32 chars, should be random)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_random_jwt_secret_min_32_chars_here

# JWT token expiration (default: 8h)
JWT_EXPIRES=8h

# Master key for AES-256-GCM encryption of credentials (min 32 chars, should be random)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# CRITICAL: If this changes, .finops_setup becomes unreadable — store safely
MASTER_KEY=your_random_master_key_min_32_chars_here

# ========================================
# AZURE SERVICE PRINCIPAL (Coleta Azure)
# ========================================
# These credentials are used to authenticate with Azure Resource Manager, Resource Graph, etc.
# Never exposed to the frontend; loaded at boot and held in memory only

AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_SP_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_SP_CLIENT_SECRET=your_azure_sp_secret_here

# ========================================
# DATABRICKS SERVICE PRINCIPAL (Coleta Databricks)
# ========================================
# OAuth M2M (Machine-to-Machine) credentials for Databricks account-level access
# Used for System Tables, workspace provisioning, and cost analysis

DATABRICKS_ACCOUNT_ID=your_databricks_account_id
DATABRICKS_CLIENT_ID=your_databricks_client_id
DATABRICKS_CLIENT_SECRET=your_databricks_client_secret
DATABRICKS_WORKSPACE_HOST=https://region.cloud.databricks.com

# Optional: Personal Access Token mode (alternative to OAuth M2M)
# DATABRICKS_PAT=your_personal_access_token

# ========================================
# ENTRA ID / MICROSOFT OAUTH (SSO)
# ========================================
# Microsoft Entra ID OAuth 2.0 for single sign-on
# Application (client) ID and secret registered in Azure AD

ENTRA_TENANT_ID=your_entra_tenant_id
ENTRA_CLIENT_ID=your_entra_application_id
ENTRA_CLIENT_SECRET=your_entra_client_secret
ENTRA_REDIRECT_URI=http://localhost:3000/auth/callback

# ========================================
# ACTIVE DIRECTORY / LDAP (Optional)
# ========================================
# On-premises Active Directory or LDAP authentication

LDAP_ENABLED=false
LDAP_HOST=your_ldap_host
LDAP_PORT=389
LDAP_USER=cn=admin,dc=example,dc=com
LDAP_PASSWORD=your_ldap_password
LDAP_BASE_DN=dc=example,dc=com
LDAP_SEARCH_FILTER=(sAMAccountName={{username}})

# ========================================
# SMTP / EMAIL ALERTS
# ========================================
# SMTP server for sending alert emails (coleta com erro, orçamento estourado, etc.)
# If SMTP_ENABLED=false, alerts only appear in the in-app notification panel

SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_ADDRESS=finops-alerts@example.com
SMTP_DEFAULT_RECIPIENTS=admin@example.com,alerts@example.com

# ========================================
# PRICE LIST SYNC (Optional)
# ========================================
# Azure Retail Prices API (already public, no auth needed)
# Only customize if you want to override default behavior

PRICE_LIST_SYNC_ENABLED=true
PRICE_LIST_SYNC_INTERVAL_HOURS=24
PRICE_LIST_CURRENCY=USD

# ========================================
# LOGGING & MONITORING
# ========================================
DEBUG=finops:*
LOG_LEVEL=info

# ========================================
# FEATURE FLAGS (Optional)
# ========================================
# Enable/disable experimental features

FEATURE_INVENTARIO=true
FEATURE_ALOCACAO=true
FEATURE_DATABRICKS=true
FEATURE_PORTAL_PUBLICO=true

# ========================================
# PORTAL PÚBLICO (Calculadora Azure pública)
# ========================================
# Public portal configuration — always read from .env, not from the database UI

PORTAL_PUBLICO_ENABLED=false
PORTAL_TITULO=Azure Cost Calculator
PORTAL_DESCRICAO=Public calculator for Azure cost estimation
PORTAL_SUBSCRIPTION_IDS=
PORTAL_TAXA_IMPOSTO=18.65
PORTAL_TAXA_COND=0
PORTAL_SOLICITAR_IDENTIFICACAO=false
PORTAL_DOMINIOS_ACEITOS=

# ========================================
# DEVELOPMENT & DEBUGGING
# ========================================
# Only for local development; never set in production

SEED_DB_ON_START=false
MOCK_AZURE_API=false
SYNC_PRICE_LIST_ON_START=false

# ========================================
# DEPLOYMENT CONTEXT
# ========================================
# These may be set by deployment platforms automatically

ENVIRONMENT=development
# Render, Railway, Fly.io, etc. set these automatically:
# DATABASE_URL, PORT (sometimes), INSTANCE_ID, REGION

# ========================================
# SECRETS CHECKLIST
# ========================================
# Before deploying, ensure you have set (never commit these to .env if checking in):
#
# Required:
#  ☐ DB_PASSWORD or DATABASE_URL
#  ☐ JWT_SECRET (min 32 chars, random)
#  ☐ MASTER_KEY (min 32 chars, random, store safely)
#  ☐ AZURE_TENANT_ID, AZURE_SP_CLIENT_ID, AZURE_SP_CLIENT_SECRET
#  ☐ ALLOWED_ORIGIN (set to your actual domain in prod)
#
# Optional (if using these features):
#  ☐ DATABRICKS_* (if Coleta Databricks enabled)
#  ☐ ENTRA_* (if SSO via Entra ID)
#  ☐ LDAP_* (if AD/LDAP authentication)
#  ☐ SMTP_* (if email alerts enabled)
#
# For production: ALL secrets should be strong, random, and rotated regularly.
