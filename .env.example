# FinOps Manager — variáveis de ambiente
#
# Este arquivo é um TEMPLATE de referência. Os valores reais vão no .env, que é
# gitignored e nunca deve ser commitado.
#
# ONDE FICAM OS SEGREDOS (corrigido em 2026-10-18 — este cabeçalho afirmava o
# contrário do que o código faz, e isso induziu a erro):
#
#   - Credenciais da APLICAÇÃO ficam no BANCO, cifradas com a MASTER_KEY:
#       * Service Principals da Azure  -> tabela azure_coleta_config
#       * Senha do SMTP de alertas     -> tabela integracoes (tipo='smtp')
#       * Relay do Mailing             -> tabela integracoes (tipo='mailing_relay'), sem senha
#     São cadastradas pelas telas do sistema, não por este arquivo. Editar aqui
#     não tem efeito nenhum.
#
#   - Este arquivo guarda só o que o processo precisa ANTES de existir banco:
#     conexão, chaves de sessão/cifra e porta.
#
# CONSEQUÊNCIA IMPORTANTE: a MASTER_KEY faz parte do backup, junto com o dump do
# banco. Perder ou trocar a chave torna ilegíveis todas as credenciais salvas —
# elas precisam ser recadastradas uma a uma pelas telas.
#
# Todas as variáveis abaixo são lidas pelo código. Em 2026-10-18 havia 47 outras
# neste arquivo que nenhuma linha do projeto lia (SMTP_*, LDAP_*, ENTRA_*,
# AZURE_*, DATABRICKS_*, PORTAL_*, FEATURE_*, PRICE_LIST_*...), resquício de
# quando a configuração vinha daqui. Foram removidas: segredo real em arquivo que
# ninguém lê é risco sem contrapartida, e dá a falsa impressão de estar ativo.

# ========================================
# BANCO DE DADOS
# ========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finops_db
DB_USER=postgres
DB_PASSWORD=sua_senha_do_postgres

# Alternativa às DB_* acima (Railway, Render, Fly.io). Se definida e DB_HOST
# estiver vazia, o servidor extrai host/porta/base/usuário/senha dela.
# DATABASE_URL=postgresql://postgres:senha@localhost:5432/finops_db?sslmode=require

# ========================================
# SERVIDOR
# ========================================
PORT=3000
TZ=America/Sao_Paulo

# Origem permitida para CORS. Em produção, a URL HTTPS real do sistema.
ALLOWED_ORIGIN=http://localhost:3000

# Lido pelo Express e por várias dependências (cache de views, verbosidade de
# erro). Não é lido diretamente pelo código deste projeto.
NODE_ENV=development

# ========================================
# SEGURANÇA — obrigatórias, mínimo 32 caracteres
# ========================================

# Assina os tokens de sessão. Trocar invalida todas as sessões abertas.
JWT_SECRET=troque_por_uma_string_longa_e_aleatoria_de_32_chars_ou_mais

# Validade do token de sessão (formato do jsonwebtoken: 8h, 7d, 30m...).
JWT_EXPIRES=8h

# Cifra e decifra as credenciais guardadas no banco (AES-256-GCM).
# NÃO PERCA E NÃO TROQUE sem antes recadastrar as integrações: sem ela, o dump
# do banco é inútil para recuperar SMTP e Service Principals.
MASTER_KEY=troque_por_uma_string_longa_e_aleatoria_de_32_chars_ou_mais

# ========================================
# .env CIFRADO (opcional)
# ========================================
# Em vez do .env em texto puro, o servidor aceita .env.enc + .env.key
# (AES-256-GCM, ver encrypt-env.js). Se os dois existirem, têm precedência.
# Atenção: o .env.key tem o mesmo modo de falha da MASTER_KEY — perdeu, não abre.
